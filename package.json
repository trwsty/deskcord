{
    "name": "deskcord",
    "version": "0.6.0",
    "private": "true",
    "description": "Discord desktop mod focused on reversible performance controls and local CSS themes",
    "license": "GPL-3.0-or-later",
    "author": "Deskcord contributors; based on Vencord by Vendicated and contributors",
    "scripts": {
        "build": "node --require=./scripts/suppressExperimentalWarnings.js scripts/build/build.mjs --disable-updater",
        "buildStandalone": "pnpm build --standalone",
        "buildWeb": "node --require=./scripts/suppressExperimentalWarnings.js scripts/build/buildWeb.mjs",
        "buildWebStandalone": "pnpm buildWeb --standalone",
        "buildReporter": "pnpm buildWebStandalone --reporter --skip-extension",
        "buildReporterDesktop": "pnpm build --reporter",
        "watch": "pnpm build --watch",
        "dev": "pnpm watch",
        "watchWeb": "pnpm buildWeb --watch",
        "generatePluginJson": "tsx scripts/generatePluginList.ts",
        "generateTypes": "tspc --emitDeclarationOnly --declaration --outDir packages/vencord-types --allowJs false",
        "inject": "node scripts/deskcord/install.mjs install",
        "uninject": "node scripts/deskcord/install.mjs uninstall",
        "lint": "oxlint",
        "fmt": "oxfmt \"**/*.{css,html,json,yml,yaml}\"",
        "fmt:check": "pnpm fmt --check",
        "lint:fix": "pnpm lint --fix",
        "test": "pnpm build:catalog && pnpm test:ts && pnpm test:deskcord && pnpm build --dev && pnpm verify:bundle && pnpm lint && pnpm fmt:check",
        "test:ts": "tsc --noEmit",
        "bump": "./scripts/bump.sh",
        "install:list": "node scripts/deskcord/install.mjs list",
        "test:deskcord": "tsx --test tests/*.test.ts",
        "preview:deskcord": "node scripts/deskcord/preview.mjs",
        "test:ui": "node scripts/deskcord/test-ui.mjs",
        "package:deskcord": "node scripts/deskcord/package.mjs",
        "prepare:github": "node scripts/deskcord/prepare-github.mjs",
        "build:installer": "node scripts/deskcord/build-installer.mjs",
        "test:installer": "node scripts/deskcord/test-installer.mjs",
        "verify:bundle": "node scripts/deskcord/verify-build.mjs",
        "build:catalog": "node scripts/deskcord/build-catalog.mjs"
    },
    "dependencies": {
        "@intrnl/xxhash64": "catalog:",
        "@vap/core": "catalog:",
        "@vap/shiki": "catalog:",
        "@vencord/monaco-editor": "catalog:",
        "fflate": "catalog:",
        "gifenc": "catalog:",
        "postcss": "^8.5.32",
        "postcss-value-parser": "^4.2.0"
    },
    "devDependencies": {
        "@electron/asar": "^4.3.1",
        "@stylistic/eslint-plugin": "catalog:",
        "@types/chrome": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/yazl": "catalog:",
        "@vencord/discord-types": "workspace:",
        "diff": "catalog:",
        "esbuild": "catalog:",
        "eslint-plugin-path-alias": "catalog:",
        "eslint-plugin-simple-header": "catalog:",
        "eslint-plugin-simple-import-sort": "catalog:",
        "html-minifier-terser": "catalog:",
        "lodash": "catalog:",
        "moment": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "p-limit": "catalog:",
        "puppeteer-core": "catalog:",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "standalone-electron-types": "catalog:",
        "svgo": "catalog:",
        "ts-patch": "catalog:",
        "ts-pattern": "catalog:",
        "tsx": "catalog:",
        "type-fest": "catalog:",
        "typescript": "catalog:",
        "typescript-transform-paths": "catalog:",
        "yazl": "^3.3.1",
        "zip-local": "catalog:"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@12.15.0"
}
